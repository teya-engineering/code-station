{
  "environments": [
    { "name": "dev", "title": "Dev" },
    { "name": "prd", "title": "Prod", "danger": true },
    { "name": "shared", "title": "Shared" }
  ],
  "dispatch": {
    "oauth": {
      "grant": "authorizationCodePKCE",
      "authURL": "https://id.example.com/oauth/v2/authorize",
      "tokenURL": "https://id.example.com/oauth/v2/token",
      "clientID": "00000000-0000-0000-0000-000000000000",
      "scope": "openid",
      "callbackURL": "http://127.0.0.1:8234/callback"
    },
    "requests": [
      {
        "name": "List orders",
        "method": "GET",
        "url": "https://api.{{env}}.example.com/orders-service/v1/orders"
      },
      {
        "name": "Start the order consumer",
        "method": "PUT",
        "url": "https://api.{{env}}.example.com/orders-service/v1/internal/consumer/start"
      }
    ]
  },
  "mcp": {
    "presets": [
      {
        "name": "grafana-platform-dev",
        "title": "Grafana platform dev",
        "environment": "dev",
        "command": "mcp-grafana",
        "env": {
          "GRAFANA_URL": "https://grafana.platform-dev.example.com",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": ""
        }
      },
      {
        "name": "grafana-platform-prd",
        "title": "Grafana platform prod",
        "environment": "prd",
        "command": "mcp-grafana",
        "env": {
          "GRAFANA_URL": "https://grafana.platform-prd.example.com",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": ""
        }
      },
      {
        "name": "grafana-shared-shared",
        "title": "Grafana shared",
        "environment": "shared",
        "command": "mcp-grafana",
        "env": {
          "GRAFANA_URL": "https://grafana.shared.example.com",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": ""
        }
      }
    ]
  },
  "skills": {
    "name": "Example Engineering",
    "marketplace": "example-engineering",
    "repository": "https://github.com/example/claude-plugins"
  },
  "shortcuts": [
    {
      "name": "Orders service",
      "command": "./gradlew :orders-service:bootRun"
    }
  ]
}
